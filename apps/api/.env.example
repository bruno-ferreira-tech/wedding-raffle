# ==============================================================================
# Wedding Raffle — API Backend Environment Config (NestJS)
# ==============================================================================

PORT=3001
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wedding_raffle

# Authentication Passwords
ADMIN_PASSWORD=admin-password-dos-noivos
PADRINHO_PASSWORD=padrinho-password

# Session Signing Key (HMAC SHA-256, at least 32 characters)
SESSION_SECRET=coloque-aqui-uma-chave-secreta-forte-com-mais-de-32-caracteres

# Payment Provider: fake | mercadopago | stripe
PAYMENT_PROVIDER=fake

# Stripe Settings (when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Mercado Pago Settings (when PAYMENT_PROVIDER=mercadopago)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
MERCADO_PAGO_WEBHOOK_SECRET=

# CORS Allowed Origins (single URL or comma-separated list)
WEB_ORIGIN=http://localhost:3000

# Cookie security (set to true in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
