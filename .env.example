# ==============================================================================
# Wedding Raffle (Corta-Gravata Digital) — Docker Compose Environment Config
# ==============================================================================

# Database settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wedding_raffle
POSTGRES_PORT=5432

# Backend Authentication & Security
ADMIN_PASSWORD=senha-mestre-dos-noivos
PADRINHO_PASSWORD=senha-dos-padrinhos
SESSION_SECRET=coloque-aqui-uma-chave-secreta-forte-com-mais-de-32-caracteres

# Payment Provider Configuration: fake | mercadopago | stripe
PAYMENT_PROVIDER=fake

# Stripe Credentials (required if PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Mercado Pago Credentials (required if PAYMENT_PROVIDER=mercadopago)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
MERCADO_PAGO_WEBHOOK_SECRET=

# Frontend & CORS Configuration
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
COOKIE_SECURE=false
